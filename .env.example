# Nukopijuok į .env ir įrašyk savo raktą. .env į Git nekeliamas.
# Modeliai nurodomi config/models.toml, LLM promptas – config/prompts.toml.
OPENAI_API_KEY=
# OpenAI suderinamas API adresas (be jo naudojamas api.openai.com).
OPENAI_BASE_URL=https://api-lb.i4tech.lt/v1
# Katalogas, kuriame yra dataset\ (ne pats dataset). Numatyta: projekto šaknis.
DATA_ROOT=.
